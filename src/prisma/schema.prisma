// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// Better Auth Tables
// ============================================

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token") @db.Text
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

// ============================================
// Organizations
// ============================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  settings  Json     @default("{}")
  plan             CompanyPlan @default(STL200)
  stlLimit         Int         @default(200) @map("stl_limit")
  billingStatus    String?     @map("billing_status")
  contractStartDate DateTime?  @map("contract_start_date")
  isActive         Boolean     @default(true) @map("is_active")
  closedAt         DateTime?   @map("closed_at")
  closedReason     String?     @map("closed_reason") @db.Text

  users       User[]
  patients    Patient[]
  printers    Printer[]
  backups     Backup[]
  invitations Invitation[]
  slicingJobs SlicingJob[]
  usageEvents UsageEvent[]
  accessKeys  RegistrationAccessKey[]

  @@map("organizations")
}

enum CompanyPlan {
  STL200
  STL400
  STL750
  CUSTOM
}

// ============================================
// Users (integrated with Better Auth)
// ============================================

model User {
  id            String   @id @default(uuid())
  orgId         String?  @map("org_id")
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  name          String
  image         String?
  role          UserRole @default(DOCTOR)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  settings      Json     @default("{}")

  organization        Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  projects            Project[]
  scans               Scan[]
  auditLogs           AuditLog[]
  sessions            Session[]
  accounts            Account[]
  invitationsSent     Invitation[]  @relation("InvitedBy")
  invitationsAccepted Invitation[]  @relation("AcceptedBy")
  slicingJobs         SlicingJob[]
  usageEvents         UsageEvent[]
  accessKeysIssued    RegistrationAccessKey[] @relation("AccessKeyIssuedBy")
  accessKeysRedeemed  RegistrationAccessKey[] @relation("AccessKeyRedeemedBy")

  @@map("users")
}

enum AccessKeyStatus {
  ACTIVE
  REDEEMED
  DISABLED
  EXPIRED
}

model RegistrationAccessKey {
  id             String          @id @default(uuid())
  code           String          @unique
  label          String?
  plan           CompanyPlan     @default(STL200)
  stlLimit       Int             @default(200) @map("stl_limit")
  status         AccessKeyStatus @default(ACTIVE)
  createdForEmail String?        @map("created_for_email")
  notes          String?         @db.Text
  metadata       Json            @default("{}")
  expiresAt      DateTime?       @map("expires_at")
  redeemedAt     DateTime?       @map("redeemed_at")
  issuedToOrgId  String?         @map("issued_to_org_id")
  issuedById     String?         @map("issued_by_id")
  redeemedById   String?         @map("redeemed_by_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [issuedToOrgId], references: [id], onDelete: SetNull)
  issuedBy     User?         @relation("AccessKeyIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  redeemedBy   User?         @relation("AccessKeyRedeemedBy", fields: [redeemedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([issuedToOrgId])
  @@map("registration_access_keys")
}

enum UsageEventType {
  STL_UPLOADED
  STL_EXPORTED
  PRINT_STARTED
  PROJECT_OPENED
  DESIGN_OPENED
  DESIGN_CREATED
}

model UsageEvent {
  id         String         @id @default(uuid())
  orgId      String         @map("org_id")
  userId     String?        @map("user_id")
  eventType  UsageEventType @map("event_type")
  quantity   Int            @default(1)
  resourceId String?        @map("resource_id")
  metadata   Json           @default("{}")
  createdAt  DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, eventType, createdAt])
  @@index([userId, eventType, createdAt])
  @@map("usage_events")
}

enum UserRole {
  ADMIN
  DOCTOR
}

// ============================================
// Invitations
// ============================================

model Invitation {
  id           String    @id @default(uuid())
  orgId        String    @map("org_id")
  email        String?
  code         String?   @unique
  role         UserRole  @default(DOCTOR)
  expiresAt    DateTime  @map("expires_at")
  acceptedAt   DateTime? @map("accepted_at")
  invitedById  String    @map("invited_by_id")
  acceptedById String?   @map("accepted_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id])
  acceptedBy   User?        @relation("AcceptedBy", fields: [acceptedById], references: [id])

  @@index([orgId])
  @@index([email])
  @@index([code])
  @@map("invitations")
}

// ============================================
// Patients
// ============================================

model Patient {
  id        String    @id @default(uuid())
  orgId     String    @map("org_id")
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  birthDate DateTime? @map("birth_date") @db.Date
  notes     String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projects     Project[]

  @@index([orgId])
  @@map("patients")
}

// ============================================
// Projects
// ============================================

model Project {
  id        String        @id @default(uuid())
  patientId String        @map("patient_id")
  doctorId  String?       @map("doctor_id")
  name      String
  date      DateTime      @db.Date
  status    ProjectStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  deletedAt DateTime?     @map("deleted_at")

  patient Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User?    @relation(fields: [doctorId], references: [id])
  scans   Scan[]
  designs Design[]

  @@index([patientId])
  @@map("projects")
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

// ============================================
// Scans
// ============================================

model Scan {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  name       String   @default("")
  pairId     String   @default(uuid()) @map("pair_id") // Groups left + right scans together
  footSide   FootSide
  stlUrl     String   @map("stl_url")
  uploadedBy String?  @map("uploaded_by")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User?   @relation(fields: [uploadedBy], references: [id])

  @@index([projectId])
  @@index([pairId])
  @@map("scans")
}

enum FootSide {
  LEFT
  RIGHT
}

// ============================================
// Designs
// ============================================

model Design {
  id             String    @id @default(uuid())
  projectId      String    @map("project_id")
  parameters     Json      @default("{}")
  elements       Json      @default("[]")
  matchTransform Json?     @map("match_transform")
  landmarks      Json?     @default("{}") // ThreePointLandmarks + DerivedLandmarks + FootGeometry
  scanMetadata   Json?     @map("scan_metadata") @default("{}") // bounding box, units, vertex count for re-import validation
  clientSettings Json?     @map("client_settings") @default("{}") // Local UI state: corrections, printer settings, hardness, etc.
  stlUrl         String?   @map("stl_url")
  gcodeUrl       String?   @map("gcode_url")
  version        Int       @default(1)
  parentDesignId String?   @map("parent_design_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentDesign Design?  @relation("DesignVersions", fields: [parentDesignId], references: [id])
  childDesigns Design[] @relation("DesignVersions")

  @@index([projectId])
  @@map("designs")
}

// ============================================
// Slicing Jobs (Local Print Agent queue)
// ============================================

enum SlicingJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model SlicingJob {
  id               String           @id @default(uuid())
  userId           String           @map("user_id")
  orgId            String           @map("org_id")
  status           SlicingJobStatus @default(PENDING)
  stlBase64        String           @map("stl_base64") @db.Text
  stlFilename      String?          @map("stl_filename")
  gcodeBase64      String?          @map("gcode_base64") @db.Text
  gcodeFilename    String?          @map("gcode_filename")
  printerModel     String?          @map("printer_model")
  nozzleSize       String?          @map("nozzle_size")
  material         String?
  slicerProfileName String?         @map("slicer_profile_name")
  printerSettings  Json?            @map("printer_settings")
  slicerMeta       Json?            @map("slicer_meta")
  errorMessage     String?          @map("error_message") @db.Text
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([orgId, status, createdAt])
  @@map("slicing_jobs")
}

// ============================================
// Printers
// ============================================

model Printer {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  name      String
  brand     String?
  model     String?
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("printers")
}

// ============================================
// Backups
// ============================================

model Backup {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  type      String?
  url       String?
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("backups")
}

// ============================================
// Audit Logs
// ============================================

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  action      String
  targetTable String?  @map("target_table")
  targetId    String?  @map("target_id")
  diff        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
