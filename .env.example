# Copy to .env.local for local dev, or add these in the Vercel project → Settings → Environment Variables.
# Required for production runtime (and recommended for preview builds that hit the database).

# Database (PostgreSQL / Supabase)
DATABASE_URL=
DIRECT_URL=

# Auth (Better Auth) — https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Supabase Storage (STL uploads)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (optional; invitations disabled without RESEND_API_KEY)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TEST_EMAIL=

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# 3D printer cloud (optional)
RAISECLOUD_API_KEY=
RAISECLOUD_API_SECRET=
