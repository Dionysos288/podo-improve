DATABASE_URL=
DIRECT_URL=

BETTER_AUTH_SECRET=
# Full URL or hostname (https:// added automatically), e.g. https://podo-improve.vercel.app
BETTER_AUTH_URL=
NEXT_PUBLIC_APP_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

RESEND_FROM_EMAIL=
RESEND_API_KEY=

# Supabase Storage (NEXT_PUBLIC_SUPABASE_URL optional if DATABASE_URL is Supabase-hosted)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Print Agent (Windows exe — publish with: npm run agent:publish)
# Hosted on GitHub Releases (>50MB; Supabase Storage free tier limit is 50MB).
# Copy from agent/print-agent/release.manifest.json into Vercel env after publish.
AGENT_VERSION=2.0.1
AGENT_EXE_URL=https://github.com/Dionysos288/podo-improve/releases/download/agent-v2.0.1/podo-print-agent.exe
AGENT_EXE_SHA256=

# 3D Printing / Printer Integration (Optional)
RAISECLOUD_API_KEY=
RAISECLOUD_API_SECRET=
IDEAMAKER_PATH=
